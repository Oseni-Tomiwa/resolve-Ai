{
  "extends": "../../packages/typescript-config/nextjs.json",
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "./.next/types/**/*.ts",
    "./app/**/*.ts",
    "./app/**/*.tsx",
    "./next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "./node_modules",
    "./.next",
    "./dist",
    "./build",
    "./coverage"
  ]
}
